project: savantenvs/proot
target: proot-link2symlink
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/proot-link2symlink/testsuite
cmds:
  # proot-replay replays the input's syscalls through proot's translator (mayhem/harnesses/replay_main.c)
  - cmd: /mayhem/out/proot-replay link @@ -l -H -0
    afl: true
    timeout: 10
